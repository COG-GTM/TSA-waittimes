# Vendor feed credentials (see app/sources/credentials.py). Copy to .env, fill in,
# and `source .env` before running the app or scripts/probe_source.py. On Fly:
#   fly secrets set FEED_KEY_DEN=... FEED_KEY_MCO=... (etc.)
# A source whose credential is unset fails closed: no request is sent and
# /healthz reports it unhealthy with "FEED_KEY_<CODE> is not configured".
export FEED_KEY_DEN=
export FEED_KEY_MCO=
export FEED_KEY_HOUSTON=
export FEED_KEY_DFW=
export FEED_KEY_CLT=
export FEED_KEY_CVG=
export FEED_KEY_LAS=
export FEED_KEY_BOS=
export FEED_KEY_PIT=
export FEED_KEY_PHX=
export FEED_KEY_MIA=
